ion":"JetUP's official short explainer of the Sonic AI Profit Share across 10 levels, and how direct partners unlock them.","thumbnailUrl":"https://mtgtribe.com/jetup/img/cover-profit-share.webp","uploadDate":"2026-11-06T00:00:00+02:00","duration":"PT1M14S","contentUrl":"https://mtgtribe.com/jetup/media/jetup-profit-share-explained.mp4","inLanguage":"en-ZA"},{"@type":"VideoObject","name":"Meet your JetUP Assistant (Beta): JetUP's own video","description":"JetUP's official 51-second video on the JetUP Assistant, the AI helper in your JetUP Dashboard: give it a name, set a goal, get one next step every day, track your incentive progress, find people in your branch, see who is close to the next level and check your team's Dennis Promo (Check 100+100). The names and numbers in the video are JetUP's demo data.","thumbnailUrl":"https://mtgtribe.com/jetup/img/cover-jetup-assistant.jpg","uploadDate":"2026-11-06T00:00:00+02:00","duration":"PT51S","contentUrl":"https://mtgtribe.com/jetup/media/jetup-assistant-beta.mp4","inLanguage":"en-ZA"}]}</script>
