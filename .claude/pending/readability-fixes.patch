 <script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://mtgtribe.com/bw/#site","url":"https://mtgtribe.com/bw/","name":"Bitcoin Wealth Guide by MTG","alternateName":["Bitcoin Wealth Guide","MTG Bitcoin Wealth","mtgtribe.com/bw"],"description":"Independent, plain-English Bitcoin Wealth education by MTG: how it works, how to join safely, free tools, and how to check every payment on the blockchain.","inLanguage":"en-ZA","publisher":{"@id":"https://mtgtribe.com/bw/#mtg"},"author":{"@id":"https://mtgtribe.com/bw/#mtg"}},{"@type":"Person","@id":"https://mtgtribe.com/bw/#mtg","name":"MTG","alternateName":["MusaTheGiant","Musa the Giant"],"jobTitle":"Your Digital Architect","description":"MTG, Your Digital Architect: creator of independent, plain-English crypto education, videos and free tools, and host of the MTG TRIBE community.","url":"https://www.musathegiant.com","sameAs":["https://www.musathegiant.com","https://www.tiktok.com/@joinmtgtribe","https://www.youtube.com/@mtgtribe","https://www.facebook.com/mtgtribe","https://t.me/mtgtribe"],"knowsAbout":["Bitcoin","Bitcoin Wealth","BTCB","Web3 wallets","SafePal","BNB Smart Chain","Crypto safety","Affiliate marketing"]},{"@type":"WebPage","@id":"https://mtgtribe.com/bw/dashboard/glossary/#webpage","url":"https://mtgtribe.com/bw/dashboard/glossary/","name":"Bitcoin Wealth glossary: crypto words in plain English","description":"Bitcoin, BTCB, BNB, smart contract, slot, recycle, BscScan and more: Bitcoin Wealth words explained in plain English with everyday examples.","inLanguage":"en-ZA","isPartOf":{"@id":"https://mtgtribe.com/bw/#site"},"author":{"@id":"https://mtgtribe.com/bw/#mtg"},"publisher":{"@id":"https://mtgtribe.com/bw/#mtg"},"about":{"@type":"Thing","name":"Bitcoin Wealth","alternateName":["BW","Bitcoin Wealth Vow Unity"],"description":"A Bitcoin matrix programme run by a smart contract on BNB Smart Chain: members enter once with 0.001 BTC (as BTCB) and payments move wallet to wallet."},"isAccessibleForFree":true,"datePublished":"2026-11-14","dateModified":"2026-11-22","breadcrumb":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#breadcrumb"},"hasPart":[{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}],"primaryImageOfPage":{"@type":"ImageObject","url":"https://mtgtribe.com/bw/img/bitcoin-wealth-glossary-preview.jpg?v=6849b392","width":1200,"height":630}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Bitcoin Wealth guide","item":"https://mtgtribe.com/bw/"},{"@type":"ListItem","position":2,"name":"Dashboard","item":"https://mtgtribe.com/bw/dashboard/"},{"@type":"ListItem","position":3,"name":"Glossary","item":"https://mtgtribe.com/bw/dashboard/glossary/"}],"@id":"https://mtgtribe.com/bw/dashboard/glossary/#breadcrumb"},{"@type":"DefinedTermSet","@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset","name":"Bitcoin Wealth glossary: crypto words in plain English","url":"https://mtgtribe.com/bw/dashboard/glossary/","hasDefinedTerm":[{"@type":"DefinedTerm","name":"Bitcoin (BTC)","description":"Digital money with no bank behind it, live since 2009. Only 21 million will ever exist. Like: Digital gold: scarce, and nobody can print more.","url":"https://mtgtribe.com/bw/dashboard/glossary/#bitcoin","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Satoshi","description":"The smallest piece of a Bitcoin: one hundred millionth. 0.001 BTC is 100,000 satoshis. Like: Cents in a rand, but much smaller.","url":"https://mtgtribe.com/bw/dashboard/glossary/#satoshi","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"BTCB","description":"Bitcoin's value on BNB Smart Chain, issued by Binance and backed one to one by Bitcoin it holds. Like: A voucher you can swap back for the real thing.","url":"https://mtgtribe.com/bw/dashboard/glossary/#btcb","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"BNB","description":"The coin that pays network fees on BNB Smart Chain. Like: The postage stamp on every letter you send.","url":"https://mtgtribe.com/bw/dashboard/glossary/#bnb","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"BNB Smart Chain (BEP20)","description":"The blockchain Bitcoin Wealth runs on. BEP20 is the name for tokens on it. Like: The road the delivery truck drives on.","url":"https://mtgtribe.com/bw/dashboard/glossary/#bsc","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Smart contract","description":"A program on the blockchain that runs its rules automatically, the same way for everyone. Like: A vending machine: the right coin in, the snack out, no shopkeeper.","url":"https://mtgtribe.com/bw/dashboard/glossary/#smart-contract","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Web3 wallet","description":"An app like SafePal or MetaMask that holds the keys to your crypto. You own it, not a company. Like: Your own house keys.","url":"https://mtgtribe.com/bw/dashboard/glossary/#wallet","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Recovery phrase","description":"The 12 secret words that can restore your wallet on any phone. Never share them. Like: The master key to your house. Never give out a copy.","url":"https://mtgtribe.com/bw/dashboard/glossary/#phrase","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Slot","description":"One of 12 levels in Bitcoin Wealth, from 0.001 BTC to 2.048 BTC. Like: Floors in a building: each one costs double the one below.","url":"https://mtgtribe.com/bw/dashboard/glossary/#slot","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Position","description":"One of the 14 seats below you in a cycle: 2, then 4, then 8. Like: Seats on a bus that fill as people board.","url":"https://mtgtribe.com/bw/dashboard/glossary/#position","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Cycle","description":"One round of 14 filled positions at a slot. Like: One full bus trip.","url":"https://mtgtribe.com/bw/dashboard/glossary/#cycle","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Recycle","description":"When a cycle completes, one payment puts you back into the same slot so it can pay again. Like: Buying the next bus ticket from this trip's fares.","url":"https://mtgtribe.com/bw/dashboard/glossary/#recycle","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Auto entry","description":"Slots 2 to 12 are bought for you with two payments from your first cycle at the slot below. Like: A free upgrade, earned by filling the bus below.","url":"https://mtgtribe.com/bw/dashboard/glossary/#auto-entry","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Spillover","description":"When your upline's team overflows, new members can land in positions below you. Like: Extra passengers sent to your bus when the one ahead is full.","url":"https://mtgtribe.com/bw/dashboard/glossary/#spillover","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Royal Pool","description":"In later cycles one payment goes to a pool shared monthly by members who reach slot 3 and qualify.","url":"https://mtgtribe.com/bw/dashboard/glossary/#royal-pool","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"BscScan","description":"The public website where anyone can look up BNB Smart Chain addresses and transactions. Like: A public bank statement everyone can read.","url":"https://mtgtribe.com/bw/dashboard/glossary/#bscscan","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Token approval","description":"Permission you give a contract to move a token from your wallet. Approve only what you need. Like: Signing a debit order: check the amount.","url":"https://mtgtribe.com/bw/dashboard/glossary/#approval","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Gas (network fee)","description":"The small fee in BNB paid for every transaction on BNB Smart Chain.","url":"https://mtgtribe.com/bw/dashboard/glossary/#gas","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Halving","description":"About every four years, the reward for mining new Bitcoin is cut in half.","url":"https://mtgtribe.com/bw/dashboard/glossary/#halving","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}},{"@type":"DefinedTerm","name":"Renounced","description":"A contract whose owner has given up control for good. Bitcoin Wealth's contract is not renounced.","url":"https://mtgtribe.com/bw/dashboard/glossary/#renounced","inDefinedTermSet":{"@id":"https://mtgtribe.com/bw/dashboard/glossary/#definedtermset"}}]}]}</script>
 </head>
