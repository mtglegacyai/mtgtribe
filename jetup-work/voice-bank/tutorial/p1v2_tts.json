 "sentences": [
  {
   "key": "n_thanks",
   "start": 0.28,
   "end": 2.385,
   "text": "Thank you for taking the time to watch this video."
  },
  {
   "key": "n_inthis",
   "start": 2.695,
   "end": 8.16,
   "text": "In this video, I'll show you how to create your Jet Up account, step by step, on your phone."
  },
  {
   "key": "n_ov1",
   "start": 9.02,
   "end": 13.595,
   "text": "You'll open the Partner link, choose Individual, and type your real name and email."
  },
  {
   "key": "n_ov2",
   "start": 13.905,
   "end": 18.625,
   "text": "Then you'll create a password, add your country and phone number, and tap Register Now."
  },
  {
   "key": "n_ov3",
   "start": 19.37,
   "end": 23.625,
   "text": "Finally, you'll verify your email, log in, and check your profile."
  },
  {
   "key": "s_name",
   "start": 24.01,
   "end": 27.575,
   "text": "Use your real first and last name, exactly as on your ID."
  },
  {
   "key": "s_pw12",
   "start": 28.43,
   "end": 32.625,
   "text": "Your password can have up to twelve characters, so write it down somewhere safe."
  },
  {
   "key": "s_tip",
   "start": 32.77,
   "end": 37.9,
   "text": "If it says the email is already registered, use another email, or log in with that one."
  },
  {
   "key": "s_regok",
   "start": 38.85,
   "end": 42.12,
   "text": "Registration successful! Now check your email."
  },
  {
   "key": "s_open",
   "start": 42.225,
   "end": 45.915,
   "text": "Open the email from I B Portal, and tap Verify Account."
  },
  {
   "key": "s_verified",
   "start": 46.135,
   "end": 49.285,
   "text": "Your email is verified. Tap Continue to Login."
  },
  {
   "key": "s_login",
   "start": 50.13,
   "end": 52.59,
   "text": "Log in with the email and password you just created."
  },
  {
   "key": "s_in",
   "start": 52.77,
   "end": 56.075,
   "text": "And you're in! Your profile shows Account Type: Partner."
  },
  {
   "key": "r_intro",
   "start": 56.375,
   "end": 58.175,
   "text": "Let's recap what we covered in this video."
  },
  {
   "key": "r1",
   "start": 58.94,
   "end": 61.605,
   "text": "You opened the Partner link and chose Individual."
  },
  {
   "key": "r2",
   "start": 61.665,
   "end": 66.69,
   "text": "You typed your real name and email, and created a password of up to twelve characters."
  },
  {
   "key": "r3",
   "start": 67.555,
   "end": 71.36,
   "text": "You added your country and phone number, and tapped Register Now."
  },
  {
   "key": "r4",
   "start": 71.845,
   "end": 77.015,
   "text": "Then you verified your email, logged in, and saw Account Type: Partner on your profile."
  },
  {
   "key": "x1",
   "start": 77.96,
   "end": 82.27,
   "text": "In the next video, part two, I'll show you how to link Jet Up to TAG Markets."
  },
  {
   "key": "x2",
   "start": 82.37,
   "end": 89.29,
   "text": "You'll sync your account through Copy X, confirm your TAG Markets email, and log in to your TAG Markets dashboard."
  }
 ],
